{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Testbench common definitions",
  "description": "Identifiers, names, field types and field entries shared by every Testbench artifact and step.",
  "x-testbench": {
    "valueFormats": {
      "description": "The text a value must match for its dataType. A type not listed takes any text.",
      "BOOLEAN": "^(true|false)$",
      "DATE": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "DATETIME": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?Z$",
      "TIME": "^[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?Z?$",
      "INTEGER": "^-?[0-9]+$",
      "LONG": "^-?[0-9]+$",
      "DOUBLE": "^-?[0-9]+(\\.[0-9]+)?$",
      "CURRENCY": "^-?[0-9]+(\\.[0-9]+)?$",
      "PERCENT": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "listValueDataTypes": ["MULTIPICKLIST"],
    "referenceDataTypes": ["ID", "REFERENCE"],
    "specialReferenceValues": {
      "StandardPricebookId": ["REFERENCE"]
    },
    "principalFields": {
      "description": "Fields whose value is a name the run resolves, never an Id. Their dataType is always PICKLIST.",
      "RecordTypeId": "the record type's developer name",
      "ProfileId": "the profile's name",
      "UserRoleId": "the role's developer name",
      "PermissionSetId": "the permission set's API name",
      "PermissionSetGroupId": "the permission set group's developer name",
      "PermissionSetLicenseId": "the permission set licence's developer name"
    },
    "operatorsByDataType": {
      "description": "The operators a comparison may use for each dataType. A type not listed may use the default list.",
      "default": ["eq", "ne"],
      "BOOLEAN": ["eq", "ne"],
      "MULTIPICKLIST": ["includes", "excludes"],
      "INTEGER": ["eq", "ne", "gt", "lt", "ge", "le"],
      "LONG": ["eq", "ne", "gt", "lt", "ge", "le"],
      "DOUBLE": ["eq", "ne", "gt", "lt", "ge", "le"],
      "CURRENCY": ["eq", "ne", "gt", "lt", "ge", "le"],
      "PERCENT": ["eq", "ne", "gt", "lt", "ge", "le"],
      "DATE": ["eq", "ne", "gt", "lt", "ge", "le"],
      "DATETIME": ["eq", "ne", "gt", "lt", "ge", "le"],
      "TIME": ["eq", "ne", "gt", "lt", "ge", "le"],
      "STRING": [
        "eq",
        "ne",
        "contains",
        "not contains",
        "startswith",
        "endswith"
      ],
      "TEXTAREA": [
        "eq",
        "ne",
        "contains",
        "not contains",
        "startswith",
        "endswith"
      ],
      "PHONE": [
        "eq",
        "ne",
        "contains",
        "not contains",
        "startswith",
        "endswith"
      ],
      "EMAIL": [
        "eq",
        "ne",
        "contains",
        "not contains",
        "startswith",
        "endswith"
      ],
      "URL": ["eq", "ne", "contains", "not contains", "startswith", "endswith"]
    },
    "describeTypes": {
      "description": "How a describe field type maps to a dataType, where the upper-cased name differs.",
      "int": "INTEGER"
    }
  },
  "$defs": {
    "featureTestCategoryGuid": {
      "type": "string",
      "pattern": "^C[0-9a-f]{32}$"
    },
    "featureTestGuid": {
      "type": "string",
      "pattern": "^T[0-9a-f]{32}$"
    },
    "featureTestVersionGuid": {
      "type": "string",
      "pattern": "^V[0-9a-f]{32}$"
    },
    "personaCategoryGuid": {
      "type": "string",
      "pattern": "^C[0-9a-f]{32}$"
    },
    "personaGuid": {
      "type": "string",
      "pattern": "^P[0-9a-f]{32}$"
    },
    "personaVersionGuid": {
      "type": "string",
      "pattern": "^V[0-9a-f]{32}$"
    },
    "dataTemplateCategoryGuid": {
      "type": "string",
      "pattern": "^C([0-9a-f]{32}|GlobalTemplates)$",
      "description": "CGlobalTemplates is Global Templates, the same in every org; every other category's GUID is generated."
    },
    "dataTemplateGuid": {
      "type": "string",
      "pattern": "^D[0-9a-f]{32}$"
    },
    "dataTemplateVersionGuid": {
      "type": "string",
      "pattern": "^V[0-9a-f]{32}$"
    },
    "nodeGuid": {
      "type": "string",
      "pattern": "^N[0-9a-f]{32}$"
    },
    "fieldEntryGuid": {
      "type": "string",
      "pattern": "^F[A-Za-z0-9_]+$"
    },
    "templateRecordReference": {
      "description": "A record a data template creates: <templateGuid>:<nodeGuid>.",
      "type": "string",
      "pattern": "^D[0-9a-f]{32}:N[0-9a-f]{32}$"
    },
    "recordReference": {
      "description": "A record an earlier step created or found (its node GUID), or a record a loaded data template created.",
      "anyOf": [
        {
          "$ref": "#/$defs/nodeGuid"
        },
        {
          "$ref": "#/$defs/templateRecordReference"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "apiName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 255
    },
    "nameList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/apiName"
      },
      "uniqueItems": true
    },
    "editorVersion": {
      "const": 1,
      "description": "The version of the Testbench editor a version's steps are written for, so a later Testbench reads them as they were meant. Every version in a v1 file is written for editor version 1. Required: left out, the org would stamp its own current version, which a later Testbench may raise."
    },
    "nodeLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "nodeDescription": {
      "type": "string"
    },
    "labelAutoUpdate": {
      "type": "boolean"
    },
    "labelAutoUpdateTemplate": {
      "type": "string"
    },
    "dataType": {
      "description": "The field's type as the org's describe names it, in upper case.",
      "enum": [
        "STRING",
        "TEXTAREA",
        "EMAIL",
        "PHONE",
        "URL",
        "PICKLIST",
        "MULTIPICKLIST",
        "COMBOBOX",
        "ENCRYPTEDSTRING",
        "BOOLEAN",
        "DATE",
        "DATETIME",
        "TIME",
        "INTEGER",
        "LONG",
        "DOUBLE",
        "CURRENCY",
        "PERCENT",
        "ID",
        "REFERENCE"
      ]
    },
    "fieldValue": {
      "description": "Text in the format its dataType requires, a list of values for MULTIPICKLIST, or null.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "operator": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "lt",
        "ge",
        "le",
        "contains",
        "not contains",
        "startswith",
        "endswith",
        "includes",
        "excludes"
      ]
    },
    "valueEntry": {
      "description": "A field value a step writes.",
      "x-testbench": {
        "entryKind": "value"
      },
      "type": "object",
      "required": ["apiName", "dataType", "value"],
      "additionalProperties": false,
      "properties": {
        "guid": {
          "$ref": "#/$defs/fieldEntryGuid"
        },
        "apiName": {
          "$ref": "#/$defs/apiName"
        },
        "dataType": {
          "$ref": "#/$defs/dataType"
        },
        "value": {
          "$ref": "#/$defs/fieldValue"
        },
        "operator": {
          "const": "eq",
          "description": "Written by the editor and not used."
        }
      }
    },
    "comparisonEntry": {
      "description": "A field compared with an operator. Which operators apply depends on the dataType.",
      "x-testbench": {
        "entryKind": "comparison"
      },
      "type": "object",
      "required": ["apiName", "dataType", "value", "operator"],
      "additionalProperties": false,
      "properties": {
        "guid": {
          "$ref": "#/$defs/fieldEntryGuid"
        },
        "apiName": {
          "$ref": "#/$defs/apiName"
        },
        "dataType": {
          "$ref": "#/$defs/dataType"
        },
        "value": {
          "$ref": "#/$defs/fieldValue"
        },
        "operator": {
          "$ref": "#/$defs/operator"
        }
      }
    }
  }
}
