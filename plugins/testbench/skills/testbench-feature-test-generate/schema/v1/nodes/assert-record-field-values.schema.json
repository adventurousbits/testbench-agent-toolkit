{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodes/assert-record-field-values.schema.json",
  "title": "Verify field values",
  "description": "Compares fields on a record an earlier step created or found, or a template created.",
  "x-testbench": {
    "assertType": "AssertRecordFieldValues",
    "recordReferenceKeys": ["referredRecordGuid"],
    "sameObjectAsReference": true,
    "objectKey": "objectApiName",
    "objectAccess": "queryable",
    "entryLists": {
      "fieldsToAssert": {
        "kind": "comparison",
        "access": "readable"
      }
    }
  },
  "type": "object",
  "required": [
    "assertType",
    "referredRecordGuid",
    "objectApiName",
    "fieldsToAssert"
  ],
  "additionalProperties": false,
  "properties": {
    "assertType": {
      "const": "AssertRecordFieldValues"
    },
    "referredRecordGuid": {
      "$ref": "../common.schema.json#/$defs/recordReference"
    },
    "objectApiName": {
      "$ref": "../common.schema.json#/$defs/apiName"
    },
    "fieldsToAssert": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../common.schema.json#/$defs/comparisonEntry"
      }
    }
  }
}
