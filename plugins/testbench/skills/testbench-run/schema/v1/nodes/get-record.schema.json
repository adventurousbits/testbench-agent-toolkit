{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodes/get-record.schema.json",
  "title": "Find Record",
  "description": "Finds the first record that matches every filter, each compared with its own operator. Later steps refer to it by this step's guid.",
  "x-testbench": {
    "nodeType": "GetRecord",
    "editorName": "Find Record",
    "producesRecord": true,
    "failable": true,
    "objectKey": "objectApiName",
    "objectAccess": "queryable",
    "entryLists": {
      "fieldsToFilterBy": {
        "kind": "comparison",
        "access": "filterable"
      }
    }
  },
  "type": "object",
  "required": ["guid", "type", "label", "details"],
  "additionalProperties": false,
  "properties": {
    "guid": {
      "$ref": "../common.schema.json#/$defs/nodeGuid"
    },
    "type": {
      "const": "GetRecord"
    },
    "label": {
      "$ref": "../common.schema.json#/$defs/nodeLabel"
    },
    "description": {
      "$ref": "../common.schema.json#/$defs/nodeDescription"
    },
    "labelAutoUpdate": {
      "$ref": "../common.schema.json#/$defs/labelAutoUpdate"
    },
    "labelAutoUpdateTemplate": {
      "$ref": "../common.schema.json#/$defs/labelAutoUpdateTemplate"
    },
    "details": {
      "type": "object",
      "required": ["objectApiName", "fieldsToFilterBy"],
      "additionalProperties": false,
      "properties": {
        "objectApiName": {
          "$ref": "../common.schema.json#/$defs/apiName"
        },
        "fieldsToFilterBy": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/comparisonEntry"
          }
        }
      }
    }
  }
}
